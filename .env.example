# Notion integration token（Settings → Connections → Develop or manage integrations）
NOTION_TOKEN=
# 登入密碼；留空則不需要登入（只建議本機開發時留空）
APP_PASSWORD=
# 時區（預設 Asia/Tokyo）
APP_TZ=Asia/Tokyo
# 行事曆：一個或多個 iCalendar 連結（空白或逗號分隔；webcal:// 也可以）
# iPhone：行事曆 App → 行事曆 → 該行事曆旁的 ⓘ → 打開「公開行事曆」→ 分享連結
ICAL_URLS=
# AI 批改（題庫答案和參考答案對不上時才呼叫）。沒設定就改成自己判斷對錯
ANTHROPIC_API_KEY=
